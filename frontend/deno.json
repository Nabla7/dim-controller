{
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run -A npm:vite",
        "build": "deno task typecheck && deno run -A npm:vite build",
        "typecheck": "deno run -A npm:typescript/tsc --noEmit -p .",
        "test": "deno test -A --no-check test/",
        "vendor-dimos-react": "deno run -A tools/vendor_dimos_react.ts"
    },
    "imports": {
        "@sparkjsdev/spark": "npm:@sparkjsdev/spark@^2.3.1",
        "jsqr": "npm:jsqr@^1.4.0",
        "qrcode-generator": "npm:qrcode-generator@^2.0.4",
        "react": "npm:react@^19.2.0",
        "react/": "npm:/react@^19.2.0/",
        "react-dom": "npm:react-dom@^19.2.0",
        "react-dom/": "npm:/react-dom@^19.2.0/",
        "three": "npm:three@^0.180.0",
        "three/": "npm:/three@^0.180.0/",
        "@types/react": "npm:@types/react@^19.2.0",
        "@types/react-dom": "npm:@types/react-dom@^19.2.0",
        "@types/three": "npm:@types/three@^0.180.0",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.0",
        "typescript": "npm:typescript@~5.9.2",
        "vite": "npm:vite@^7.1.0",
        "@std/assert": "jsr:@std/assert@1",
        "dimos-react": "./src/vendor/dimos-react/src/index.ts",
        "dimos-react/three": "./src/vendor/dimos-react/src/three.ts",
        "dimos-react/graph": "./src/vendor/dimos-react/src/graph.ts",
        "dimos-react/dim-app/": "./src/vendor/dimos-react/src/vendor/dim-app/"
    }
}
