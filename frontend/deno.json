{
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run -A npm:vite",
        "build": "deno task typecheck && deno run -A npm:vite build",
        "typecheck": "deno check src/",
        "test": "deno test -A --no-check test/"
    },
    "imports": {
        "@sparkjsdev/spark": "npm:@sparkjsdev/spark@^2.3.1",
        "jsqr": "npm:jsqr@^1.4.0",
        "qrcode-generator": "npm:qrcode-generator@^2.0.4",
        "react": "npm:react@^19.2.0",
        "react/": "npm:/react@^19.2.0/",
        "react-dom": "npm:react-dom@^19.2.0",
        "react-dom/": "npm:/react-dom@^19.2.0/",
        "three": "npm:three@^0.180.0",
        "three/": "npm:/three@^0.180.0/",
        "@types/react": "npm:@types/react@^19.2.0",
        "@types/react-dom": "npm:@types/react-dom@^19.2.0",
        "@types/three": "npm:@types/three@^0.180.0",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.1.0",
        "typescript": "npm:typescript@~5.9.2",
        "vite": "npm:vite@^7.1.0",
        "@std/assert": "jsr:@std/assert@1",
        "dimos-react": "https://raw.githubusercontent.com/jeff-hykin/dimos-react/v0.3.1/src/index.ts",
        "dimos-react/three": "https://raw.githubusercontent.com/jeff-hykin/dimos-react/v0.3.1/src/three.ts",
        "dimos-react/dim-app/desktop.js": "https://raw.githubusercontent.com/jeff-hykin/dimos-react/v0.3.1/src/vendor/dim-app/desktop.js",
        "dimos-react/dim-app/events.js": "https://raw.githubusercontent.com/jeff-hykin/dimos-react/v0.3.1/src/vendor/dim-app/events.js",
        "dimos-react/dim-app/notify.js": "https://raw.githubusercontent.com/jeff-hykin/dimos-react/v0.3.1/src/vendor/dim-app/notify.js",
        "dimos-react/dim-app/topic.js": "https://raw.githubusercontent.com/jeff-hykin/dimos-react/v0.3.1/src/vendor/dim-app/topic.js",
        "dimos-react/dim-app/zenoh.js": "https://raw.githubusercontent.com/jeff-hykin/dimos-react/v0.3.1/src/vendor/dim-app/zenoh.js"
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "jsxImportSourceTypes": "@types/react",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable",
            "deno.ns"
        ]
    }
}
