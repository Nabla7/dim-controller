{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "maxNodeModuleJsDepth": 3,
        "paths": {
            "dimos-react": [
                "./src/vendor/dimos-react/src/index.ts"
            ],
            "dimos-react/three": [
                "./src/vendor/dimos-react/src/three.ts"
            ],
            "dimos-react/graph": [
                "./src/vendor/dimos-react/src/graph.ts"
            ],
            "dimos-react/dim-app/*": [
                "./src/vendor/dimos-react/src/vendor/dim-app/*"
            ]
        }
    },
    "include": [
        "src"
    ]
}
